          <script>function required(value, fieldName) {
    var normalized = String(value).trim();

    if (!normalized) {
        throw new Error(&apos;Missing mandatory XML field: &apos; + fieldName);
    }

    return normalized;
}

var controlId = required(
    msg[&apos;messageControlId&apos;],
    &apos;messageControlId&apos;
);

var patientId = required(
    msg[&apos;patient&apos;][&apos;id&apos;],
    &apos;patient.id&apos;
);

var lastName = required(
    msg[&apos;patient&apos;][&apos;lastName&apos;],
    &apos;patient.lastName&apos;
);

var firstName = required(
    msg[&apos;patient&apos;][&apos;firstName&apos;],
    &apos;patient.firstName&apos;
);

var dateOfBirth = required(
    msg[&apos;patient&apos;][&apos;dateOfBirth&apos;],
    &apos;patient.dateOfBirth&apos;
);

var sex = required(
    msg[&apos;patient&apos;][&apos;sex&apos;],
    &apos;patient.sex&apos;
);

var orderId = required(
    msg[&apos;order&apos;][&apos;orderId&apos;],
    &apos;order.orderId&apos;
);

var accessionId = required(
    msg[&apos;order&apos;][&apos;accessionId&apos;],
    &apos;order.accessionId&apos;
);

var panelCode = required(
    msg[&apos;order&apos;][&apos;panelCode&apos;],
    &apos;order.panelCode&apos;
);

var panelDescription = required(
    msg[&apos;order&apos;][&apos;panelDescription&apos;],
    &apos;order.panelDescription&apos;
);

var observationDateTime = required(
    msg[&apos;order&apos;][&apos;observationDateTime&apos;],
    &apos;order.observationDateTime&apos;
);

var resultStatus = required(
    msg[&apos;order&apos;][&apos;status&apos;],
    &apos;order.status&apos;
);

var resultNodes = msg[&apos;results&apos;][&apos;result&apos;];
var resultCount = resultNodes.length();

if (resultCount === 0) {
    throw new Error(&apos;The XML document contains no results&apos;);
}

for (var i = 0; i &lt; resultCount; i++) {
    required(resultNodes[i][&apos;code&apos;], &apos;results.result[&apos; + i + &apos;].code&apos;);
    required(resultNodes[i][&apos;value&apos;], &apos;results.result[&apos; + i + &apos;].value&apos;);
}

channelMap.put(&apos;controlId&apos;, controlId);
channelMap.put(&apos;patientId&apos;, patientId);
channelMap.put(&apos;lastName&apos;, lastName);
