  <postprocessingScript>logger.info(&quot;Inside.Fake.RIS.1&quot;);
var controlId = String(channelMap.get(&apos;controlId&apos;));

var now = DateUtil.getCurrentDate(&apos;yyyyMMddHHmmss&apos;);
logger.info(&quot;Inside.Fake.RIS.2&quot;);
var ack =
    &apos;MSH|^~\\&amp;|FAKE_RIS|TEST_LAB|MIRTH|INTEGRATION|&apos; +
    now +
    &apos;||ACK|ACK_&apos; + controlId + &apos;|P|2.3\r&apos; +
    &apos;MSA|AE|&apos; + controlId + &apos;|Simulated laboratory validation failure\r&apos; +
    &apos;ERR|||OBX^1^5^1|102^Data type error^HL70357|E|||Simulated invalid result value&apos;;

logger.info(
    &apos;FAKE RIS returning forced AE for controlId=[&apos; +
    controlId +
    &apos;]&apos;
);

return ack;</postprocessingScript>
