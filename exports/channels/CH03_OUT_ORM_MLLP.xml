        <com.mirth.connect.plugins.javascriptstep.JavaScriptStep version="4.5.2">
          <name>JS_PARSE_VALIDATE_ORDER</name>
          <sequenceNumber>0</sequenceNumber>
          <enabled>true</enabled>
          <script>var rawData = String(connectorMessage.getRawData()).trim();
var parts = rawData.split(&apos;,&apos;);

if (parts.length !== 10) {
    throw new Error(
        &apos;Invalid order file: expected 10 columns but received &apos; +
        parts.length
    );
}

for (var i = 0; i &lt; parts.length; i++) {
    parts[i] = String(parts[i]).trim();
}

var orderId = parts[0];
var patientId = parts[1];
var lastName = parts[2];
var firstName = parts[3];
var dateOfBirth = parts[4];
var sex = parts[5];
var serviceCode = parts[6];
var serviceDescription = parts[7];
var scheduledDateTime = parts[8];
var department = parts[9];

if (!orderId) {
    throw new Error(&apos;Missing order ID&apos;);
}

if (!patientId) {
    throw new Error(&apos;Missing patient ID&apos;);
}

if (!serviceCode) {
    throw new Error(&apos;Missing service code&apos;);
}

if (!scheduledDateTime) {
    throw new Error(&apos;Missing scheduled date/time&apos;);
}

channelMap.put(&apos;orderId&apos;, orderId);
channelMap.put(&apos;patientId&apos;, patientId);
channelMap.put(&apos;lastName&apos;, lastName);
channelMap.put(&apos;firstName&apos;, firstName);
channelMap.put(&apos;dateOfBirth&apos;, dateOfBirth);
channelMap.put(&apos;sex&apos;, sex);
channelMap.put(&apos;serviceCode&apos;, serviceCode);
channelMap.put(&apos;serviceDescription&apos;, serviceDescription);
channelMap.put(&apos;scheduledDateTime&apos;, scheduledDateTime);
channelMap.put(&apos;department&apos;, department);
channelMap.put(&apos;controlId&apos;, &apos;ORM-&apos; + orderId);</script>
